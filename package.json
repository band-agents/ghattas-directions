{
  "name": "ghattas-directions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ghattas Clinic — three website directions on the brand book, with live Remotion heroes.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5196",
    "build": "tsc --noEmit && vite build",
